# Vite environment variables (prefix VITE_ is required for client-side access).

# Address of the deployed UpstreamFunding contract on Sepolia.
# Set this after deployment. Recipient data is read on-chain; nothing is hardcoded.
VITE_UPSTREAM_FUNDING_ADDRESS=0xYourDeployedContractAddress

# Sepolia RPC URL (used by wagmi). Do not commit authenticated credentials.
VITE_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id
